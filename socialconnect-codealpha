<div class="logo">📸 SocialConnect</div>
<button class="nav-btn" onclick="toggleDarkMode()">🌙 Mode</button>
</div>

<div class="container">

<div class="post-box">

<h2>Create Post</h2>

<textarea id="postText" placeholder="What's on your mind?"></textarea>

<input type="file" id="imageInput" accept="image/*">

<button class="post-btn" onclick="createPost()">Post</button>

</div>

<div id="posts"></div>

</div>

<script>

function toggleDarkMode(){
document.body.classList.toggle("dark");
}

function createPost(){

let text =
document.getElementById("postText").value;

let file =
document.getElementById("imageInput").files[0];

if(text==="" && !file){
alert("Enter text or image");
return;
}

const reader = new FileReader();

reader.onload = function(e){

let post = document.createElement("div");

post.className="post";

post.innerHTML=`

<div class="profile">
<div class="avatar"></div>
<b>Nandhini</b>
</div>
<div class="navbar">

<p>${text}</p>

${file ? <img src="${e.target.result}"> : ''}

<div class="actions">
<button class="like" onclick="likePost(this)">
❤️ Like 0
</button>

<button class="comment">
💬 Comment
</button>
</div>
<div class="logo">📸 SocialConnect</div>
<button onclick="toggleDarkMode()" class="post-btn" style="width:auto;padding:10px 20px;">
🌙 Dark Mode
</button>
</div>
<div class="post">

<div class="profile">

<div class="avatar"></div>
<div>
<h3>Nandhini</h3>
<small>Just Now</small>
</div>

</div>

<p>
Welcome to SocialConnect 🚀
</p>

<img src="https://picsum.photos/600/350">

<!-- ACTION BUTTONS HERE -->
</div>

`;

document.getElementById("posts").prepend(post);

localStorage.setItem("lastPost",post.innerHTML);

document.getElementById("postText").value="";
document.getElementById("imageInput").value="";
};

if(file){
reader.readAsDataURL(file);
}else{
reader.onload({target:{result:""}});
}

}

function likePost(btn){

let count=parseInt(btn.innerText.split(" ")[2]);

count++;

btn.innerHTML=❤️ Like ${count};

}

</script>
